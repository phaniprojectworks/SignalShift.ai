# --- Gemini (optional: without a key the app uses deterministic template reports) ---
# Model names are read from env only. Stable models listed at https://ai.google.dev/gemini-api/docs/models
# (checked 2026-10-15; verify they are still current before use).
GEMINI_API_KEY=            # put the real key in .env or Secret Manager, never in this file
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Vertex AI instead of an API key (Google Cloud): calls Gemini as the service account (roles/aiplatform.user)
# GEMINI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id   # also links Cloud Logging lines to Cloud Trace
# GOOGLE_CLOUD_LOCATION=global

# --- Telegram (optional: the in-app inbox always works) ---
# Create a bot with @BotFather, send it /start, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  ("chat":{"id": ...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MIN_SEVERITY=warning      # critical | warning | opportunity
# TELEGRAM_MODE=polling              # polling (no public URL needed) | webhook
# TELEGRAM_WEBHOOK_SECRET=           # required in webhook mode (sent by Telegram in X-Telegram-Bot-Api-Secret-Token)

# --- Engine rules ---
AD_PAUSE_LAG_HOURS=4
ALERT_COOLDOWN_HOURS=6

# --- Mock live ad delivery (synthetic stand-in for the ad platform while the app runs) ---
# AD_SIM_ENABLED=true
# AD_SIM_INTERVAL_SECONDS=30
# AD_SIM_SPEED=20        # e.g. 20 compresses time so spend counters move visibly in a short demo

# --- Optional overrides ---
PORT=8080              # port run.py serves on
# DATABASE_PATH=signalshift.db
# TIMEZONE=Asia/Kolkata
# SEED=2026

# --- Google Cloud deployment (see deploy/GOOGLE_CLOUD.md) ---
# LITESTREAM_REPLICA_URL=gcs://your-bucket/litestream/signalshift.db   # SQLite on local disk, replicated to Cloud Storage
# STORAGE_MOUNT=/mnt/storage     # where the bucket is mounted (default mode)
# LOCAL_DB_DIR=/data             # local database folder (Litestream mode)
